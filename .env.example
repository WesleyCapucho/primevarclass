# Copie este arquivo para .env antes de usar docker compose.
# Nunca publique a chave real em repositórios, artigos ou anexos.
# Para gerar uma chave forte localmente:
#   python scripts/prepare_launch_env.py

PRIMEVARCLASS_API_KEY=troque-por-uma-chave-longa-e-aleatoria
PRIMEVARCLASS_JOB_ROOT=/app/primevarclass_job_history

# Se a interface for servida pelo mesmo domínio da API, deixe vazio.
# Se houver um frontend separado, liste as origens separadas por virgula.
PRIMEVARCLASS_CORS_ORIGINS=

# Opcionais: separe auditoria, perfis e equipes em volumes dedicados.
PRIMEVARCLASS_AUDIT_ROOT=/app/primevarclass_job_history
PRIMEVARCLASS_PROFILE_ROOT=/app/primevarclass_job_history
PRIMEVARCLASS_TEAM_ROOT=/app/primevarclass_job_history
